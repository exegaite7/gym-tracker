rules_version = '2';

// Reglas de seguridad de la base de datos.
// Traducción: "en la colección users, el documento de un usuario
// solo lo puede leer o escribir ESE mismo usuario, y solo si inició sesión".
// Sin esto, cualquiera podría ver o borrar los datos de los demás.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
